# Copiar a .env (nunca versionar el .env real) y completar con los valores del proyecto
# Supabase (local vía `supabase start`, o remoto vinculado con `supabase link`).

ENTORNO=desarrollo

# Panel de Supabase > Project Settings > API.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase > Project Settings > API > service_role (secreta -- bypasea RLS,
# nunca exponerla al frontend ni loguearla). El backend la usa para consultar
# roles_usuario/sesiones resolviendo la autorización él mismo en dominio, no delegándola
# a RLS como única capa (ver docs/ARCHITECTURE.md).
SUPABASE_SERVICE_ROLE_KEY=

# Panel de Supabase > Project Settings > API > JWT Settings > JWT Secret. Usado para
# validar la firma HS256 de los JWT que emite Supabase Auth/GoTrue (proyectos con clave
# de firma simétrica -- ver la nota de migración a JWKS/RS256 en
# contextos/identidad/infraestructura/validador_jwt_supabase.py).
SUPABASE_JWT_SECRET=

# Claim "aud" que Supabase Auth pone en los JWT de usuarios autenticados. No suele
# necesitar cambiarse.
SUPABASE_JWT_AUDIENCIA=authenticated

# Orígenes permitidos para CORS, separados por coma (ej. http://localhost:3000). Vacío
# en este PR porque el frontend todavía no existe.
CORS_ORIGENES=
