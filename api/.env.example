# Copiar a .env (nunca versionar el .env real) y completar con los valores del proyecto
# Supabase (local vía `supabase start`, o remoto vinculado con `supabase link`).

ENTORNO=desarrollo

# Panel de Supabase > Project Settings > API. Sistema nuevo de API keys de Supabase (las
# claves `sb_publishable_...`/`sb_secret_...` reemplazan a `anon`/`service_role`).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase > Project Settings > API > secret key (`sb_secret_...`, secreta --
# bypasea RLS, nunca exponerla al frontend ni loguearla). El backend la usa para
# consultar roles_usuario/sesiones resolviendo la autorización él mismo en dominio, no
# delegándola a RLS como única capa (ver docs/ARCHITECTURE.md).
SUPABASE_SECRET_KEY=

# Panel de Supabase > Project Settings > API > publishable key (`sb_publishable_...`,
# pública). El backend hoy no la necesita para nada -- ninguno de sus adaptadores llama a
# Supabase sin privilegios elevados -- se documenta acá para cuando el frontend la
# consuma (cliente `supabase-js` en el navegador).
SUPABASE_PUBLISHABLE_KEY=

# Panel de Supabase > Project Settings > API > JWT Keys > JWKS URL. Este proyecto firma
# los JWT de Supabase Auth/GoTrue con claves asimétricas (ES256/RS256) rotables, no con un
# secreto simétrico -- `contextos/identidad/infraestructura/validador_jwt_supabase.py`
# resuelve la clave de firma vigente para cada token contra este endpoint.
SUPABASE_JWKS_URL=

# Claim "aud" que Supabase Auth pone en los JWT de usuarios autenticados. No suele
# necesitar cambiarse.
SUPABASE_JWT_AUDIENCIA=authenticated

# Orígenes permitidos para CORS, separados por coma (ej. http://localhost:3000). Vacío
# en este PR porque el frontend todavía no existe.
CORS_ORIGENES=
