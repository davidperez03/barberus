# Copiar a .env.local (nunca versionar el .env.local real -- ya está en .gitignore).

# URL base del backend FastAPI (api/). En desarrollo local, uv run uvicorn lo sirve en
# el puerto 8000 (ver api/README.md). NEXT_PUBLIC_ porque lo consume código de cliente
# (contextos/identidad/infraestructura/repositorio-identidad-http.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000
