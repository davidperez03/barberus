# Variables de entorno para el CLI de Supabase (supabase/config.toml), no para el backend
# (eso vive en api/.env.example). Copiar a .env en la raiz del repo (nunca versionar el
# real) antes de correr `supabase config push`.

# SMTP de produccion para los correos de Supabase Auth (confirmacion de registro,
# recuperacion de contrasena) -- reemplaza el limite bajo del envio de pruebas por
# defecto. Ejemplo con Gmail + contrasena de aplicacion:
# https://myaccount.google.com/apppasswords (requiere verificacion en 2 pasos activa).
BARBERUS_SMTP_USER=tu-correo@gmail.com
BARBERUS_SMTP_PASS=contrasena-de-aplicacion-16-caracteres
